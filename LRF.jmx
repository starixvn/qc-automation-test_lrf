          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Generate Before10Day" enabled="true">
            <stringProp name="scriptLanguage">javascript</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">var now = new Date();
var Before10Day = new Date(now.setDate(now.getDate() - 10));

var formatDateComponent = function(dateComponent) {
  return (dateComponent &lt; 10 ? &apos;0&apos; : &apos;&apos;) + dateComponent;
};

var formatDate = function(date) {
  return formatDateComponent(date.getMonth() + 1) + &apos;/&apos; + formatDateComponent(date.getDate()) + &apos;/&apos; + date.getFullYear();
};

vars.put(&quot;Before10Day&quot;,formatDate(Before10Day));
</stringProp>
          </JSR223PostProcessor>
