          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Generate FromDate - ToDate" enabled="true">
            <stringProp name="scriptLanguage">javascript</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">var now = new Date();
var prevMonthLastDate = new Date(now.getFullYear(), now.getMonth(),0);
var prevMonthFirstDate = new Date(now.getFullYear() - (now.getMonth() &gt; 0 ? 0 : 1), (now.getMonth() - 1 + 12) % 12, 1);
var yesterday = new Date(now.setDate(now.getDate() - 1));

var formatDateComponent = function(dateComponent) {
  return (dateComponent &lt; 10 ? &apos;0&apos; : &apos;&apos;) + dateComponent;
};

var formatDate = function(date) {
  return formatDateComponent(date.getMonth() + 1) + &apos;/&apos; + formatDateComponent(date.getDate()) + &apos;/&apos; + date.getFullYear();
};

vars.put(&quot;FirstDateofPrevMonth&quot;,formatDate(prevMonthFirstDate));
vars.put(&quot;DateRange&quot;,formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(prevMonthLastDate));
vars.put(&quot;LastDateofPrevMonth&quot;,formatDate(prevMonthLastDate));



//var curr = new Date;
//var firstday = new Date(curr.setDate(curr.getDate() - curr.getDay()));
//var lastday = new Date(curr.setDate(curr.getDate() - curr.getDay()-1));

//document.getElementById(&quot;demo&quot;).innerHTML = firstday;</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Customer Reports_Customer Turnover_Submit" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
	&quot;fromdate&quot;:&quot;${FirstDateofPrevMonth}&quot;,&#xd;
	&quot;todate&quot;:&quot;${LastDateofPrevMonth}&quot;,&#xd;
	&quot;reportby&quot;:&quot;1&quot;,&#xd;
	&quot;showwin&quot;:true,&#xd;
	&quot;showloss&quot;:true,&#xd;
	&quot;showdraw&quot;:true,&#xd;
	&quot;odds&quot;:&quot;0&quot;,&#xd;
	&quot;SportProducts&quot;:[{&quot;ID&quot;:0,&quot;ParentId&quot;:-1,&#xd;
				&quot;Name&quot;:&quot;Sportbook&quot;,&#xd;
				&quot;Checked&quot;:true},{&quot;ID&quot;:1,&#xd;
							&quot;ParentId&quot;:0,&#xd;
