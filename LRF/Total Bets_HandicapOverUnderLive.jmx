          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Get: MoveBetsDay - BalanceUpDay" enabled="true">
            <stringProp name="scriptLanguage">javascript</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="script">var response = &quot;${BetListMetaModel}&quot;;
var MoveBetsDay = response.substr(response.indexOf(&quot;MoveBetsDay&quot;) + 25,19);
var BalanceUpDay = response.substr(response.indexOf(&quot;BalanceUpDay&quot;) + 26,19);
//var BalanceUpDayConvert = new Date(Number(BalanceUpDay.substr(a.indexOf(&quot;Date&quot;) + 5,13)));
vars.put(&quot;MoveBetsDay&quot;, MoveBetsDay);    
vars.put(&quot;BalanceUpDay&quot;, BalanceUpDay);    
//vars.put(&quot;BalanceUpDayConvert&quot;, formatDate(BalanceUpDayConvert));   

</stringProp>
          </JSR223PostProcessor>
