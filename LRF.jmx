            <stringProp name="script">//var datamatch = &quot;${datamatch}&quot;;
//var datamatch = datamatch.replace(&quot;&amp;quot;&quot;,&quot;\&quot;&quot;);
//vars.put(&quot;test&quot;, datamatch);
//var JSONObj = JSON.parse(datamatch.replace(&quot;&amp;quot;&quot;,&quot;\&quot;&quot;));

//vars.put(&quot;MatchId&quot;, JSONObj.MatchId);    
//vars.put(&quot;LeagueId&quot;, JSONObj.LeagueId); 
//vars.put(&quot;ProductCode&quot;, JSONObj.ProductCode); 
//vars.put(&quot;RaceNo&quot;, JSONObj.RaceNo);    
//vars.put(&quot;HomeId&quot;, JSONObj.HomeId); 
//vars.put(&quot;AwayId&quot;, JSONObj.AwayId); 

import groovy.json.JsonSlurper

def jsonSlurper = new JsonSlurper();
def datamatch = &quot;${datamatch}&quot;;
def str2 = datamatch.replaceAll(&quot;&amp;quot;&quot;,&quot;\&quot;&quot;);
def response = jsonSlurper.parseText(str2);
vars.put(&quot;MatchId&quot;, response.MatchId.toString());
vars.put(&quot;LeagueId&quot;, response.LeagueId.toString());
vars.put(&quot;ProductCode&quot;, response.ProductCode.toString());
vars.put(&quot;RaceNo&quot;, response.RaceNo.toString());
vars.put(&quot;HomeId&quot;, response.HomeId.toString());
vars.put(&quot;AwayId&quot;, response.AwayId.toString());



</stringProp>
