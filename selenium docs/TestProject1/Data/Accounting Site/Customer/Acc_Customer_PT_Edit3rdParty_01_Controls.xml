<?xml version="1.0" encoding="utf-8" ?>
<DataSet>
  <filter thirdParty="Casino" level="super">
    <linkEditControl>//a[text()='Edit Casino']</linkEditControl>
    <titlePage>//td[@class='maincontent_headerC' and text()='Update PT Casino']</titlePage>
    <txtMaxTransferCredit>txtMaxTransferCredit</txtMaxTransferCredit>
    <cmbSuperMaxPT>9_0_SPre</cmbSuperMaxPT>
    <cmbSuperMinPT>9_0_SMin</cmbSuperMinPT>
    <cmbSuperComm>9_0_SComm</cmbSuperComm>
    <btnSuperMaxPTUp1>9_0_SPre_BtnInc_1</btnSuperMaxPTUp1>
    <btnSuperMaxPTDown1>9_0_SPre_BtnDec_1</btnSuperMaxPTDown1>
    <btnSuperMaxPTUp10>9_0_SPre_BtnInc_10</btnSuperMaxPTUp10>
    <btnSuperMaxPTDown10>9_0_SPre_BtnDec_10</btnSuperMaxPTDown10>
    <btnSuperMinPTUp1>9_0_SMin_BtnInc_1</btnSuperMinPTUp1>
    <btnSuperMinPTDown1>9_0_SMin_BtnDec_1</btnSuperMinPTDown1>
    <btnSuperMinPTUp10>9_0_SMin_BtnInc_10</btnSuperMinPTUp10>
    <btnSuperMinPTDown10>9_0_SMin_BtnDec_10</btnSuperMinPTDown10>
    <chkSyncData>//input[@onclick='IsSyncData(this)']</chkSyncData>
    <btnUpdate>btnAdd</btnUpdate>
    <thirdPartyName>Casino</thirdPartyName>
  </filter>
  <filter thirdParty="Bingo" level="super">
    <linkEditControl>//a[text()='Edit Bingo']</linkEditControl>
    <titlePage>//td[@class='maincontent_headerC fixfont' and contains(text(),'Update Bingo Setting')]</titlePage>
    <txtMaxTransferCredit>txtMaxTransferCredit</txtMaxTransferCredit>
    <cmbSuperMaxPT>listMaxPT_1</cmbSuperMaxPT>
    <cmbSuperMinPT>listMinPT_1</cmbSuperMinPT>
    <cmbSuperComm>listComm_1</cmbSuperComm>
    <btnSuperMaxPTUp1>//input[@class='btn-inc1']</btnSuperMaxPTUp1>
    <btnSuperMaxPTDown1>//input[@class='btn-dec1']</btnSuperMaxPTDown1>
    <btnSuperMaxPTUp10>//input[@class='btn-inc10']</btnSuperMaxPTUp10>
    <btnSuperMaxPTDown10>//input[@class='btn-dec10']</btnSuperMaxPTDown10>
    <btnSuperMinPTUp1>btnI1Hdp</btnSuperMinPTUp1>
    <btnSuperMinPTDown1>btnR1Hdp</btnSuperMinPTDown1>
    <btnSuperMinPTUp10>btnI10Hdp</btnSuperMinPTUp10>
    <btnSuperMinPTDown10>btnR10Hdp</btnSuperMinPTDown10>
    <chkSyncData>//input[@onclick='IsSyncData(this)']</chkSyncData>
    <btnUpdate>tblUpdate</btnUpdate>
    <thirdPartyName>Bingo</thirdPartyName>
  </filter>
  
</DataSet>
