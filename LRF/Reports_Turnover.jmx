        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Generate: Today - Month - Year" enabled="true">
          <stringProp name="scriptLanguage">javascript</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey"></stringProp>
          <stringProp name="script">var d = new Date(&quot;${glb_LastDateofPrevMonth}&quot;);
var Today = d.getDate();
var Month = d.getMonth() + 1;
var Year = d.getFullYear();

//var aaa = &quot;bc&quot;+&quot;${BaseCurrency}&quot;;
//document.write(formatDate(prevMonthFirstDate) + &apos; - &apos; + formatDate(prevMonthLastDate));
vars.put(&quot;Today&quot;,Today); //31
vars.put(&quot;Month&quot;,Month); //1
vars.put(&quot;Year&quot;,Year); //2018</stringProp>
        </JSR223Sampler>
